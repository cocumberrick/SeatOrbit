# Public Ticketmaster Discovery API consumer key (Vite variables are visible in the browser).
VITE_TICKETMASTER_API_KEY=

# Optional: pin one event or venue after identifying its ID from the API.
VITE_TICKETMASTER_EVENT_ID=
VITE_TICKETMASTER_VENUE_ID=
VITE_TICKETMASTER_VENUE_NAME=Canada Life Centre

# Approved Ticketmaster/Impact affiliate destination. Use only a URL issued for your account.
VITE_TICKETMASTER_URL=

# Optional public Stripe Payment Link for a one-time $2.00 CAD fan-flag slot.
# Configure Stripe's after-payment redirect to your site with:
# ?fan_flag_return=1&session_id={CHECKOUT_SESSION_ID}
# Payment Link URLs are public; never put Stripe secret keys in VITE_* variables.
VITE_STRIPE_FAN_FLAG_PAYMENT_URL=

# Optional static-host subpath override, e.g. /canada-life-centre/ for GitHub Pages.
# GitHub Actions can infer the repository path; Vercel and Netlify use / by default.
VITE_BASE_PATH=
